#!/usr/bin/env bash
set -euo pipefail

BUNDLE="/usr/lib/tela/bundle.js"
MIN_NODE_MAJOR=18
MIN_BUN_MAJOR=1

if [[ ! -f "$BUNDLE" ]]; then
	echo "tela: no se encontró el bundle en $BUNDLE" >&2
	exit 1
fi

run_with_node() {
	local major
	major=$(node --version | sed 's/^v\([0-9]*\).*/\1/')
	if (( major < MIN_NODE_MAJOR )); then
		echo "tela: node v${major} es demasiado antiguo (se requiere >= ${MIN_NODE_MAJOR})" >&2
		exit 1
	fi
	exec node "$BUNDLE" "$@"
}

run_with_bun() {
	local major
	major=$(bun --version | cut -d. -f1)
	if (( major < MIN_BUN_MAJOR )); then
		echo "tela: bun v${major} es demasiado antiguo (se requiere >= ${MIN_BUN_MAJOR})" >&2
		exit 1
	fi
	exec bun "$BUNDLE" "$@"
}

if command -v node >/dev/null 2>&1; then
	run_with_node "$@"
elif command -v bun >/dev/null 2>&1; then
	run_with_bun "$@"
else
	echo "tela: se requiere node (>= ${MIN_NODE_MAJOR}) o bun para ejecutar tela" >&2
	exit 1
fi
